{
  "kind": "dashboard",
  "id": "bench-reference",
  "title": "Bench — reference layout",
  "root": {
    "id": "root",
    "type": "canvas",
    "children": [
      {
        "id": "rail-panel",
        "type": "panel",
        "title": "Rail",
        "col": 0,
        "row": 0,
        "colSpan": 8,
        "rowSpan": 6,
        "children": [
          {
            "id": "rail-plot",
            "type": "waveform",
            "read": "psu1.1.voltage",
            "reads": [
              "eload1.1.current"
            ],
            "window": 60,
            "traces": {
              "psu1.1.voltage": {
                "name": "Rail voltage"
              },
              "eload1.1.current": {
                "name": "Load current"
              }
            }
          }
        ]
      },
      {
        "id": "supply",
        "type": "panel",
        "title": "Supply",
        "col": 8,
        "row": 0,
        "colSpan": 4,
        "rowSpan": 3,
        "children": [
          {
            "id": "supply-reads",
            "type": "row",
            "children": [
              {
                "id": "v",
                "type": "readout",
                "read": "psu1.1.voltage",
                "label": "Voltage",
                "size": "lg",
                "warnMax": 29,
                "limitMax": 30
              },
              {
                "id": "i",
                "type": "readout",
                "read": "psu1.1.current",
                "label": "Current",
                "size": "md"
              }
            ]
          },
          {
            "id": "out",
            "type": "toggle",
            "label": "Output",
            "read": "psu1.1.output",
            "write": "psu1.1.set_output"
          },
          {
            "id": "setv",
            "type": "setpoint",
            "label": "Set voltage",
            "read": "psu1.1.voltage_setpoint",
            "write": "psu1.1.set_voltage",
            "variant": "stepper"
          },
          {
            "id": "seti",
            "type": "setpoint",
            "label": "Current limit",
            "read": "psu1.1.current_limit",
            "write": "psu1.1.set_current",
            "variant": "stepper"
          }
        ]
      },
      {
        "id": "load",
        "type": "panel",
        "title": "Load",
        "col": 8,
        "row": 3,
        "colSpan": 4,
        "rowSpan": 3,
        "children": [
          {
            "id": "p",
            "type": "readout",
            "read": "eload1.1.power",
            "label": "Power",
            "size": "md"
          },
          {
            "id": "in",
            "type": "toggle",
            "label": "Input",
            "read": "eload1.1.input",
            "write": "eload1.1.set_input"
          },
          {
            "id": "setc",
            "type": "setpoint",
            "label": "Set current",
            "read": "eload1.1.current_set",
            "write": "eload1.1.set_current",
            "variant": "stepper"
          }
        ]
      },
      {
        "id": "temps",
        "type": "panel",
        "title": "Temperatures",
        "col": 0,
        "row": 6,
        "colSpan": 12,
        "rowSpan": 3,
        "children": [
          {
            "id": "temps-plot",
            "type": "waveform",
            "read": "daq1.ai0",
            "reads": [
              "daq1.ai1",
              "daq1.ai2",
              "daq1.ai3",
              "daq1.ai4",
              "daq1.ai5",
              "daq1.ai6",
              "daq1.ai7"
            ],
            "window": 600,
            "traces": {
              "daq1.ai0": {
                "name": "TC 1"
              },
              "daq1.ai1": {
                "name": "TC 2"
              },
              "daq1.ai2": {
                "name": "TC 3"
              },
              "daq1.ai3": {
                "name": "TC 4"
              },
              "daq1.ai4": {
                "name": "TC 5"
              },
              "daq1.ai5": {
                "name": "TC 6"
              },
              "daq1.ai6": {
                "name": "TC 7"
              },
              "daq1.ai7": {
                "name": "TC 8"
              }
            }
          }
        ]
      }
    ]
  }
}
