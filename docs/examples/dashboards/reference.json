{
  "kind": "dashboard",
  "id": "bench-reference",
  "title": "Bench — reference layout",
  "root": {
    "id": "root",
    "type": "canvas",
    "children": [
      {
        "id": "rail",
        "type": "panel",
        "title": "Rail",
        "col": 0,
        "row": 0,
        "colSpan": 8,
        "rowSpan": 5,
        "children": [
          {
            "id": "rail-plot",
            "type": "waveform",
            "read": "psu1.1.voltage",
            "reads": [
              "eload1.1.current"
            ],
            "window": 60,
            "traces": {
              "psu1.1.voltage": {
                "name": "Rail voltage",
                "color": "#E6B400"
              },
              "eload1.1.current": {
                "name": "Load current",
                "color": "#12B5D4"
              }
            }
          }
        ]
      },
      {
        "id": "psu1-1",
        "type": "panel",
        "title": "Supply",
        "col": 8,
        "row": 0,
        "colSpan": 4,
        "rowSpan": 3,
        "children": [
          {
            "id": "psu1-1-r",
            "type": "row",
            "children": [
              {
                "id": "psu1-1-v",
                "type": "readout",
                "read": "psu1.1.voltage",
                "label": "Voltage",
                "size": "lg",
                "accent": "#E6B400",
                "warnMax": 29,
                "limitMax": 30
              },
              {
                "id": "psu1-1-i",
                "type": "readout",
                "read": "psu1.1.current",
                "label": "Current",
                "size": "md"
              }
            ]
          },
          {
            "id": "psu1-1-out",
            "type": "toggle",
            "label": "Output",
            "read": "psu1.1.output",
            "write": "psu1.1.set_output"
          },
          {
            "id": "psu1-1-sv",
            "type": "setpoint",
            "label": "Set voltage",
            "read": "psu1.1.voltage_setpoint",
            "write": "psu1.1.set_voltage",
            "variant": "stepper"
          },
          {
            "id": "psu1-1-si",
            "type": "setpoint",
            "label": "Current limit",
            "read": "psu1.1.current_limit",
            "write": "psu1.1.set_current",
            "variant": "stepper"
          }
        ]
      },
      {
        "id": "eload1",
        "type": "panel",
        "title": "Load",
        "col": 8,
        "row": 3,
        "colSpan": 4,
        "rowSpan": 2,
        "children": [
          {
            "id": "eload1-r",
            "type": "row",
            "children": [
              {
                "id": "eload1-i",
                "type": "readout",
                "read": "eload1.1.current",
                "label": "Current",
                "size": "lg",
                "accent": "#12B5D4"
              },
              {
                "id": "eload1-p",
                "type": "readout",
                "read": "eload1.1.power",
                "label": "Power",
                "size": "md"
              }
            ]
          },
          {
            "id": "eload1-in",
            "type": "toggle",
            "label": "Input",
            "read": "eload1.1.input",
            "write": "eload1.1.set_input"
          },
          {
            "id": "eload1-sc",
            "type": "setpoint",
            "label": "Set current",
            "read": "eload1.1.current_set",
            "write": "eload1.1.set_current",
            "variant": "stepper"
          }
        ]
      },
      {
        "id": "temps",
        "type": "panel",
        "title": "Temperatures",
        "col": 0,
        "row": 5,
        "colSpan": 12,
        "rowSpan": 3,
        "children": [
          {
            "id": "temps-plot",
            "type": "waveform",
            "read": "daq1.ai0",
            "reads": [
              "daq1.ai1",
              "daq1.ai2",
              "daq1.ai3"
            ],
            "window": 600,
            "traces": {
              "daq1.ai0": {
                "name": "TC 1",
                "color": "#D63AF0"
              },
              "daq1.ai1": {
                "name": "TC 2",
                "color": "#22B573"
              },
              "daq1.ai2": {
                "name": "TC 3",
                "color": "#F57C00"
              },
              "daq1.ai3": {
                "name": "TC 4",
                "color": "#3D7DFF"
              }
            }
          }
        ]
      }
    ]
  }
}
