[
  {
    "id": "dut1-graph",
    "type": "panel",
    "title": "Bus",
    "col": 0,
    "row": 0,
    "colSpan": 8,
    "rowSpan": 2,
    "children": [
      {
        "id": "dut1-graph-plot",
        "type": "waveform",
        "read": "dut1.bus_voltage",
        "reads": [
          "dut1.bus_current"
        ],
        "window": 60,
        "traces": {
          "dut1.bus_voltage": {
            "name": "Bus voltage",
            "color": "#E6B400"
          },
          "dut1.bus_current": {
            "name": "Bus current",
            "color": "#12B5D4"
          }
        }
      }
    ]
  },
  {
    "id": "dut1",
    "type": "panel",
    "title": "DUT",
    "col": 8,
    "row": 0,
    "colSpan": 4,
    "rowSpan": 2,
    "children": [
      {
        "id": "dut1-r",
        "type": "row",
        "children": [
          {
            "id": "dut1-bus_voltage",
            "type": "readout",
            "read": "dut1.bus_voltage",
            "label": "Bus voltage",
            "size": "lg",
            "accent": "#E6B400"
          },
          {
            "id": "dut1-bus_current",
            "type": "readout",
            "read": "dut1.bus_current",
            "label": "Bus current",
            "size": "md",
            "accent": "#12B5D4"
          },
          {
            "id": "dut1-board_temp",
            "type": "readout",
            "read": "dut1.board_temp",
            "label": "Board temp",
            "size": "md"
          }
        ]
      },
      {
        "id": "dut1-en",
        "type": "toggle",
        "label": "Enable",
        "read": "dut1.enable",
        "write": "dut1.set_enable"
      }
    ]
  }
]
