{
  "kind": "dashboard",
  "id": "bench-overview",
  "title": "Bench overview",
  "root": {
    "id": "root",
    "type": "canvas",
    "children": [
      {
        "id": "main-plot-panel",
        "type": "panel",
        "title": "<What it shows>",
        "col": 0,
        "row": 0,
        "colSpan": 8,
        "rowSpan": 6,
        "children": [
          {
            "id": "main-plot",
            "type": "waveform",
            "read": "<device>.<main signal>",
            "reads": [
              "<device 2>.<second signal>"
            ],
            "window": 60,
            "traces": {
              "<device>.<main signal>": {
                "name": "<Main signal>"
              },
              "<device 2>.<second signal>": {
                "name": "<Second signal>"
              }
            }
          }
        ]
      },
      {
        "id": "inst",
        "type": "panel",
        "title": "<Instrument>",
        "col": 8,
        "row": 0,
        "colSpan": 4,
        "rowSpan": 3,
        "children": [
          {
            "id": "inst-reads",
            "type": "row",
            "children": [
              {
                "id": "main",
                "type": "readout",
                "read": "<device>.<main signal>",
                "label": "<Main signal>",
                "size": "lg"
              },
              {
                "id": "aux",
                "type": "readout",
                "read": "<device>.<other signal>",
                "label": "<Other signal>",
                "size": "md"
              }
            ]
          },
          {
            "id": "out",
            "type": "toggle",
            "read": "<device>.<output>",
            "write": "<device>.<set output>",
            "label": "Output"
          },
          {
            "id": "set",
            "type": "setpoint",
            "read": "<device>.<setpoint readback>",
            "write": "<device>.<set capability>",
            "label": "<Setpoint>",
            "variant": "stepper"
          }
        ]
      },
      {
        "id": "inst2",
        "type": "panel",
        "title": "<Instrument 2>",
        "col": 8,
        "row": 3,
        "colSpan": 4,
        "rowSpan": 3,
        "children": [
          {
            "id": "second",
            "type": "readout",
            "read": "<device 2>.<second signal>",
            "label": "<Second signal>",
            "size": "md"
          },
          {
            "id": "in2",
            "type": "toggle",
            "read": "<device 2>.<input>",
            "write": "<device 2>.<set input>",
            "label": "Input"
          }
        ]
      },
      {
        "id": "slow-panel",
        "type": "panel",
        "title": "<Slow signals>",
        "col": 0,
        "row": 6,
        "colSpan": 12,
        "rowSpan": 3,
        "children": [
          {
            "id": "slow-plot",
            "type": "waveform",
            "read": "<device 3>.<signal 1>",
            "reads": [
              "<device 3>.<signal 2>"
            ],
            "window": 600,
            "traces": {
              "<device 3>.<signal 1>": {
                "name": "<Name 1>"
              },
              "<device 3>.<signal 2>": {
                "name": "<Name 2>"
              }
            }
          }
        ]
      }
    ]
  }
}
